{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notes Workbench",
  "version": "0.1.1",
  "identifier": "eu.ciesielka.notesworkbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notes Workbench",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: vault: http://vault.localhost; frame-src vault: http://vault.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Polish", "English"], "customLanguageFiles": { "Polish": "nsis/Polish.nsh" } }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxQzQ0NUU5NUJBREUyOEQKUldTTjRxMWI2VVhFVVNsMGN5RGQ0UTlrTTQ3elJhTExrVDJ5c21rWXdoaEprZmhOQk1FSE5LeGYK",
      "endpoints": ["https://github.com/pawelciesielka/notes-workbench/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
